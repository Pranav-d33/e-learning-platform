# Copy to .env.local and fill in what you need. Every variable is optional:
# with nothing set the app runs in a clearly labelled, deterministic demo mode.
# Keys are read on the server only and are never sent to the browser.

# ---------------------------------------------------------------- live AI mode
# Any OpenAI-compatible provider works. The provider is auto-detected from the key
# prefix (AIza… = Gemini, gsk_… = Groq, sk-or-… = OpenRouter) or set explicitly.
LLM_API_KEY=
# gemini | groq | openrouter | openai | custom
LLM_PROVIDER=
# Defaults: gemini-2.5-flash · llama-3.3-70b-versatile · google/gemini-2.5-flash · gpt-5-mini
LLM_MODEL=
# Only for LLM_PROVIDER=custom (or to override a preset's endpoint)
LLM_BASE_URL=
# Optional: low | medium | high — for models that support reasoning_effort
LLM_REASONING_EFFORT=
# Second-stage AI evidence check on generated answer keys (default on in live mode)
GROUNDING_JUDGE=true
LLM_TIMEOUT_MS=90000

# Provider-native names also work instead of LLM_API_KEY:
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ------------------------------------------------------------------ embeddings
# Retrieval is always BM25; embeddings add hybrid ranking. Used automatically with a
# Gemini (gemini-embedding-001) or OpenAI key. Groq/OpenRouter have no embeddings API —
# set EMBEDDING_PROVIDER=gemini + EMBEDDING_API_KEY to combine them, or leave empty.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Optional output size for models that support it (e.g. 768)
EMBEDDING_DIMENSIONS=

# ------------------------------------------------------------------- storage
# Without these, data is kept in ./.data locally, or in /tmp on Vercel (temporary).
# Upstash Redis (Vercel Marketplace → Upstash) makes uploads and quizzes durable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DATA_DIR=.data

# --------------------------------------------------------------------- limits
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=250

# Force demo behaviour even when a key is present (true/false)
DEMO_MODE=false

# Used as the HTTP-Referer for OpenRouter (optional)
PUBLIC_APP_URL=http://localhost:3000
